RewriteRule ^teamleider/vacature index.php?p=teamleider-vacature [L]
RewriteRule ^teamleider/bekijk/vacature/(.*)$ index.php?p=teamleider-bekijk-vacature&id=$1 [L]
RewriteRule ^teamleider/send-mail index.php?p=teamleider-send-mail [L]

RewriteRule ^development/todo-list(.*)$ index.php?p=development-todolist&id=$1 [L]

RewriteRule ^systeem/license index.php?p=systeem-license [L]

RewriteRule ^vertrouwenspersoon/leden index.php?p=vertrouwenspersoon-leden [L]
