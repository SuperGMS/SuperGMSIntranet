RewriteRule ^instructeur/aanvraag-beheer/(.*)$ index.php?p=instructeur-aanvraag-beheer&id=$1 [L]

RewriteRule ^teamleider/agenda index.php?p=teamleider-agenda [L]
RewriteRule ^teamleider/leermiddelen(.*)$ index.php?p=teamleider-leermiddelen&id=$1 [L]
RewriteRule ^teamleider/leden index.php?p=teamleider-leden [L]
RewriteRule ^teamleider/lid/(.*)$ index.php?p=teamleider-beheerlid&id=$1 [L]
RewriteRule ^teamleider/aanvragen index.php?p=teamleider-aanvragen [L]
RewriteRule ^teamleider/aanvraag-beheer/(.*)$ index.php?p=teamleider-aanvraag-beheer&id=$1 [L]
RewriteRule ^teamleider/tijdlijn index.php?p=teamleider-tijdlijn [L]
RewriteRule ^teamleider/aanmeldingen index.php?p=teamleider-aanmeldingen [L]
