RewriteEngine On

RewriteRule ^settings/(.+?)/?$ /index.php?p=settings&id=$1 [L]

RewriteRule ^aanmelding/(.*)$ index.php?p=lidaanmelding&id=$1 [L]
RewriteRule ^lid/(.*)$ index.php?p=ledenbeheerlid&id=$1 [L]
