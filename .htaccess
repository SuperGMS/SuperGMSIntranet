RewriteRule ^leiding/poorten index.php?p=leiding-poorten [L]
RewriteRule ^leiding/afwezigheid(.*)$ index.php?p=leiding-afwezigheid&id=$1 [L]
RewriteRule ^leiding/vacature index.php?p=leiding-vacature [L]
RewriteRule ^leiding/bekijk/vacature/(.*)$ index.php?p=leiding-bekijk-vacature&id=$1 [L]
RewriteRule ^leiding/tijdlijn index.php?p=leiding-tijdlijn [L]
