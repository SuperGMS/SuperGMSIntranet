RewriteRule ^leiding/form/vakantie/(.*)$ index.php?p=leiding-formvakantie&id=$1 [L]
RewriteRule ^leiding/form/clanpack/(.*)$ index.php?p=leiding-formclanpack&id=$1 [L]
RewriteRule ^leiding/form/contact/(.*)$ index.php?p=leiding-formcontact&id=$1 [L]
RewriteRule ^leiding/form/gegevens/(.*)$ index.php?p=leiding-formgegevens&id=$1 [L]
