RewriteRule ^leiding/form/promotie/(.*)$ index.php?p=leiding-formpromotie&id=$1 [L]

RewriteRule ^profile/(.*)$ index.php?p=profile&id=$1 [L]

RewriteCond %{REQUEST_URI} !/(api|css|forms|images|includes|js|libs|login|pages|scripts|index\.php) [NC]
RewriteRule ^/?$ index.php?p=home [L,QSA]

RewriteCond %{REQUEST_URI} !/(api|css|forms|images|includes|js|libs|login|pages|scripts|index\.php) [NC]
RewriteRule ^(.+)$ index.php?p=$1 [L,QSA]