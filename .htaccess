RewriteRule ^leiding/leden index.php?p=leiding-leden [L]
RewriteRule ^leiding/lid/(.*)$ index.php?p=leiding-beheerlid&id=$1 [L]
RewriteRule ^leiding/toevoegen/lid index.php?p=leiding-addlid [L]
RewriteRule ^leiding/geef-rank index.php?p=leiding-rank [L]
RewriteRule ^leiding/contact index.php?p=leiding-contact [L]
